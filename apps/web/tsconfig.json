{
    "extends": "@repo/typescript-config/base.json",
    "compilerOptions": {
        "lib": ["es2023", "dom", "dom.iterable"],
        "jsx": "preserve",
        "allowJs": false,
        "incremental": true,
        "plugins": [{ "name": "next" }],
        "paths": { "@/*": ["./*"] }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules", ".next"]
}
