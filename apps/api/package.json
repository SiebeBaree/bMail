{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/server.ts",
        "start": "tsx src/server.ts",
        "seed": "NODE_ENV=development tsx --env-file-if-exists=.env src/scripts/seed.ts",
        "openapi": "SKIP_ENV_VALIDATION=1 tsx src/scripts/openapi.ts",
        "vercel-build": "tsx src/scripts/migrate.ts",
        "typecheck": "tsc",
        "lint": "oxlint --deny-warnings",
        "test": "vitest run"
    },
    "dependencies": {
        "@fastify/helmet": "^13.2.0",
        "@fastify/swagger": "^9.9.2",
        "@repo/contracts": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/env": "workspace:*",
        "@repo/logger": "workspace:*",
        "@sentry/node": "^10.76.2",
        "@vercel/blob": "^2.8.2",
        "aws4fetch": "^1.0.20",
        "drizzle-orm": "catalog:",
        "fastify": "^5.12.7",
        "fastify-plugin": "^6.0.1",
        "fastify-type-provider-zod": "^7.0.0",
        "node-html-parser": "^9.0.5",
        "pino": "^10.4.0",
        "resend": "^6.34.1",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.12",
        "@repo/oxlint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.6.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "undici-types": "~8.9.0",
        "vitest": "catalog:"
    }
}
