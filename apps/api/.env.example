# The only required variable. On Vercel the Neon store sets it.
DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require

# Optional. On Vercel PUBLIC_URL defaults to the project's production domain.
# PUBLIC_URL=https://mail-api.example.com
# Lets you claim the server again after losing every device. Pick something long.
# CLAIM_CODE=

# Optional. The server generates the tracking secret and bMail sends the Resend key, both kept in Postgres. Set here,
# they win: servers deployed before that keep theirs.
# TRACKING_SECRET=
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...

# Attachments: R2 when all four are set, otherwise the project's Vercel Blob store, which sets its own variable.
# Local dev keeps them in memory.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# BLOB_READ_WRITE_TOKEN=

# SENTRY_DSN=
