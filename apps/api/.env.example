# Always required. Only these emails (comma separated) can have an account.
DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require
ALLOWED_EMAILS=you@example.com

# Required in production. Generate each secret with `openssl rand -base64 32`.
# PUBLIC_URL=https://mail-api.example.com
# BETTER_AUTH_SECRET=
# TRACKING_SECRET=
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Optional. Lets the bMail app sign in with Apple; this is its public id.
# APPLE_BUNDLE_ID=be.baree.mail
# SENTRY_DSN=
